# ============================================================
# Frame-sim — Backend agentico (RAG/) — copie para RAG/.env
# As chaves serao rotacionadas periodicamente; nunca commitar .env
# Estas credenciais são lidas somente pelo processo Node; não use VITE_* para provedores.
# ============================================================

# Gemini (obrigatoria — LLM principal e embeddings text-embedding-004)
GOOGLE_API_KEY=

# Chaves Gemini extras (opcionais) — rotação/failover no gateway
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GOOGLE_API_KEY_7=

# Modelo Gemini padrao (opcional; default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Fallbacks multi-LLM (opcionais) — SmartRouter/LLMFactory
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Jev do simulador (separado da chave global do coding-agent gateway)
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# NVIDIA DeepSeek: suportado por LLMFactory e fallback ProviderGateway.
# A chave NVIDIA nunca deve ser enviada a api.deepseek.com.
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash

# Provedores de crítica/revisão: disponíveis via preferência explícita no gateway.
NVIDIA_GLM_API_KEY=
NVIDIA_GLM_MODEL=z-ai/glm-5.3
NVIDIA_KIMI_API_KEY=
NVIDIA_KIMI_MODEL=moonshotai/kimi-k3

# Ollama local (opcional) — roteador de intencao do SmartRouter
# OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB (opcional — sem ele o RAG e desativado em fail-open)
# CHROMA_URL=http://localhost:8000

# Origens permitidas pelo Express (este projeto fixa o Vite na porta 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
