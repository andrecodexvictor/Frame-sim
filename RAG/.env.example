# ============================================================
# Frame-sim — Backend agentico (RAG/) — copie para RAG/.env
# As chaves serao rotacionadas periodicamente; nunca commitar .env
# Estas credenciais são lidas somente pelo processo Node; não use VITE_* para provedores.
# ============================================================

# Gemini (opcional para LLM; ainda utilizado pelos embeddings)
GOOGLE_API_KEY=

# Chaves Gemini extras (opcionais) — rotação/failover no gateway
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
GOOGLE_API_KEY_6=
GOOGLE_API_KEY_7=

# Modelo Gemini padrao (opcional; default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Julgamento semântico experimental das personas (somente backend)
# off mantém o comportamento atual; shadow audita sem aplicar; active aplica gates.
JEV_MODE=off
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_MS=3000
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Fallbacks multi-LLM (opcionais) — SmartRouter/LLMFactory
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Rotas explicitas. RAG/.env.local e lido primeiro e ignorado pelo Git.
# GATEWAY_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
# NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
# NVIDIA_MODELS=z-ai/glm-5.3,deepseek-ai/deepseek-v4.1-flash,moonshotai/kimi-k2.6
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash
# PROVIDER_TIMEOUT_MS=240000
# modelPreference nvidia:<id> / openrouter:<id> fixa a rota sem fallback.

# Ollama local (opcional) — roteador de intencao do SmartRouter
# OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB (opcional — sem ele o RAG e desativado em fail-open)
# CHROMA_URL=http://localhost:8000

# Origens permitidas pelo Express (este projeto fixa o Vite na porta 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Server-side spacing between NVIDIA attempts, including fallback keys.
NVIDIA_START_INTERVAL_MS=5000
